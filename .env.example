# Copy to .env.local for development, or set these in your host's environment.

# Required. Where the backend API lives, no trailing slash. Baked into the
# browser bundle at build time, so changing it means rebuilding, not restarting.
NEXT_PUBLIC_API_BASE_URL=https://api.your-site.com

# Where uploaded images are served from. Next.js will refuse to optimise images
# from a host it does not know, so this has to match the URL your media
# actually comes from — the API host, or your R2 public base URL.
NEXT_PUBLIC_BACKEND_URL=https://api.your-site.com
